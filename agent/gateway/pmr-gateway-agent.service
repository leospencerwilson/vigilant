[Unit]
Description=PMR desktop gateway agent — sync dnsmasq drop-ins from Vigilant
After=network-online.target dnsmasq.service
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/pmr-gateway-agent.env
ExecStart=/usr/local/sbin/pmr-gateway-agent.sh
# Read-only pull + writes confined to the dnsmasq drop-in dir. It reloads dnsmasq itself.
Nice=10
