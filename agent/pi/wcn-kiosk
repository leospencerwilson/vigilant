#!/bin/bash
# Fullscreen RDP session to pmr-rx54554-srv. Two transports, preferred first:
#
#   1. WireGuard  — direct to 10.1.0.10:3389 over wg0 (peer 10.255.0.10/32).
#                   ~20 ms RTT. Production path per network-design.md.
#   2. Cloudflare — 127.0.0.1:33389, an `access tcp` proxy authenticated with an
#                   Access service token. ~12 ms extra and a proxy hop, but needs
#                   no router change, so it is the fallback and the only option at
#                   a site where UDP cannot be forwarded.
#
# Loops forever, re-evaluating the transport each time, so the desktop returns by
# itself after a server reboot, a link drop, or a user logging off.
#
# Printing: the Pi's CUPS queue `brother-hl8260` (driverless IPP to the Brother at
# 192.168.88.221) is redirected into the session. Print jobs never cross either
# transport — CUPS delivers on the site LAN.
#
# Smartcard: the Dell SK-3205 keyboard's integrated CCID reader (413c:2101) is redirected
# so NHS Spine authentication can happen inside the hosted session. Unlike printing, this
# DOES cross the transport — every APDU round-trips to the PMR server, so smartcard login
# is the one operation whose feel depends on the tunnel rather than the LAN.
# Requires pcscd on the Pi; the kiosk's tty1 seat0 session is what authorises it to pcscd.
#
# Session options (smartcard / printing / clipboard / colour depth / screen blanking) are
# chosen in Watchman and pushed here by the Vigilant agent as /var/lib/wcn/kiosk.conf.
# Everything below falls back to the behaviour this script had before it could read that
# file, so an absent or corrupt one can never leave a thin client unable to start a session.
#
# Credentials: /etc/wcn-rdp.creds (root 0640). FreeRDP masks the password in `ps`.
set -u
. /etc/wcn-rdp.creds

# Which VM this counter boots into is chosen in Watchman and pushed here by the Vigilant
# agent; this file is the handoff. DEFAULT_DIRECT is the fallback for a Pi that has never
# been told (or whose file was lost), and keeps the pre-Watchman behaviour of going straight
# to the PMR server. Re-read on every reconnect, so a pushed change needs no edit here.
TARGET_FILE="/var/lib/wcn/rdp-target"
DEFAULT_DIRECT="10.1.0.10:3389"
FALLBACK="127.0.0.1:33389"
USER_FILE="/var/lib/wcn/rdp-user"
PASS_FILE="/var/lib/wcn/rdp-pass"
read_user() {
    if [ -r "$USER_FILE" ]; then
        u=$(tr -d ' \t\r\n' < "$USER_FILE")
        case "$u" in
            "" | *[!A-Za-z0-9._-]*) ;;
            *) printf '%s' "$u"; return ;;
        esac
    fi
    printf '%s' "$RDP_USER"
}
read_pass() {
    if [ -r "$PASS_FILE" ]; then
        p=$(cat "$PASS_FILE")
        [ -n "$p" ] && { printf '%s' "$p"; return; }
    fi
    printf '%s' "$RDP_PASS"
}

read_direct() {
    # Anything that is not a bare IPv4:port is IGNORED rather than used. This value is
    # interpolated into /dev/tcp/<host>/<port> and into xfreerdp's /v:, so accepting
    # arbitrary text here would turn the monitoring server into a command-injection route
    # onto every counter. The agent validates too; this is the second lock on the same door.
    if [ -r "$TARGET_FILE" ]; then
        t=$(tr -d ' \t\r\n' < "$TARGET_FILE")
        case "$t" in
            *[!0-9.:]* | "") ;;                 # malformed — fall through to the default
            *) echo "$t"; return ;;
        esac
    fi
    echo "$DEFAULT_DIRECT"
}

pick_transport() {
    d=$(read_direct)
    h=${d%%:*}
    p=${d##*:}
    if (exec 3<>/dev/tcp/"$h"/"$p") 2>/dev/null; then echo "$d"; return; fi
    if (exec 3<>/dev/tcp/127.0.0.1/33389) 2>/dev/null; then echo "$FALLBACK"; return; fi
    echo ""
}

# --- kiosk.conf handling: parse, validate, build flags -----------------------------------
# Kept as one self-contained block of functions so it can be extracted and unit-tested
# without running the session loop.
KIOSK_CONF="/var/lib/wcn/kiosk.conf"

# The defaults ARE this script's previous hardcoded behaviour: smartcard on, printing on,
# clipboard on, 16bpp, never blank. Every fallback path lands here, because a thin client
# that will not start a session is a closed pharmacy counter — far worse than one running
# with the wrong colour depth.
DEF_SMARTCARD=1
DEF_PRINTER=1
DEF_CLIPBOARD=1
DEF_BPP=16
DEF_BLANK=0

conf_get() {
    # conf_get KEY -> the raw value of the last matching KEY= line, or nothing.
    #
    # The file is PARSED, never sourced. Its contents come from the monitoring server via the
    # agent, and `.` would EXECUTE anything that ended up in there — the same reasoning as
    # read_direct's allowlist above. The agent validates before writing and every validator
    # below checks again, because this is the side that turns the value into xfreerdp argv.
    [ -r "$KIOSK_CONF" ] || return 0
    local key="$1" line out=""
    # `|| [ -n "$line" ]` so a final line with no trailing newline (a truncated write) is
    # still considered rather than silently dropped.
    while IFS= read -r line || [ -n "$line" ]; do
        line=${line//[[:space:]]/}          # values are digits only, so this is safe
        case "$line" in
            "$key="*) out=${line#*=}; out=${out%%#*} ;;
        esac
    done < "$KIOSK_CONF"
    printf '%s' "$out"
}

conf_bool() {
    # conf_bool KEY DEFAULT -> 1 or 0. Only the exact strings 1 and 0 are accepted;
    # "true", "yes", "" and anything else fall back to the default rather than being guessed.
    case "$(conf_get "$1")" in
        1) echo 1 ;;
        0) echo 0 ;;
        *) echo "$2" ;;
    esac
}

conf_bpp() {
    # A closed enum, not a range: FreeRDP takes other depths but only these three are offered
    # in Watchman, and widening the set here would let a value the UI cannot produce through.
    case "$(conf_get RDP_BPP)" in
        16) echo 16 ;;
        24) echo 24 ;;
        32) echo 32 ;;
        *) echo "$DEF_BPP" ;;
    esac
}

conf_blank_min() {
    # 0..120 inclusive. Rejects empty, negative, non-numeric and out-of-range values, so
    # nothing that has not passed a numeric check ever reaches the `xset` arithmetic below.
    local v
    v=$(conf_get BLANK_AFTER_MIN)
    case "$v" in
        "" | *[!0-9]*) echo "$DEF_BLANK"; return ;;
    esac
    if [ "$v" -le 120 ]; then echo "$v"; else echo "$DEF_BLANK"; fi
}

read_settings() {
    SMARTCARD=$(conf_bool RDP_SMARTCARD "$DEF_SMARTCARD")
    PRINTER=$(conf_bool RDP_PRINTER "$DEF_PRINTER")
    CLIPBOARD=$(conf_bool RDP_CLIPBOARD "$DEF_CLIPBOARD")
    BPP=$(conf_bpp)
    BLANK=$(conf_blank_min)
}

apply_blanking() {
    # 0 means NEVER blank, which is what every counter does today: a screen that has gone
    # black looks like a dead thin client to the person standing at it. Non-zero blanks after
    # N minutes and puts DPMS on the same timer, so the panel actually sleeps.
    if [ "$1" = 0 ]; then
        xset s off; xset -dpms; xset s noblank
    else
        local s=$(( $1 * 60 ))
        xset s "$s" "$s"; xset +dpms; xset dpms "$s" "$s" "$s"
    fi
}

build_opts() {
    # The conditional half of the xfreerdp command line. An all-defaults (or missing)
    # kiosk.conf reproduces exactly the flags this script used to hardcode, in the same
    # relative order; /bpp: is emitted from here rather than after -themes/-wallpaper, which
    # FreeRDP does not care about.
    OPTS=()
    # Explicitly negated rather than omitted, so the result does not depend on whichever
    # default this FreeRDP build was compiled with.
    if [ "$CLIPBOARD" = 1 ]; then OPTS+=( +clipboard ); else OPTS+=( -clipboard ); fi
    # Device redirections have no negative form: off means the flag is absent. The queue name
    # and its arguments are byte-identical to the pre-settings version — the printer is
    # driverless IPP and those two extra fields are what makes it work.
    if [ "$PRINTER" = 1 ]; then
        OPTS+=( /printer:brother-hl8260,"MS Publisher Imagesetter",default )
    fi
    if [ "$SMARTCARD" = 1 ]; then OPTS+=( /smartcard ); fi
    OPTS+=( /bpp:"$BPP" )
}
# --- end kiosk.conf handling -------------------------------------------------------------

# Brand the local X root before the first connection, so the counter never shows a bare grey X
# stipple or a black gap — during the initial connect, between reconnects, or after a server
# reboot it shows the WCN mark, matching the toolbox splash that ran a moment earlier. This is the
# same composed splash Plymouth would use, kept at a stable path. feh paints the root pixmap; if
# feh or the image is missing it falls back to a solid black root, which is still on-brand and can
# never be an error that stops a session starting.
WCN_SPLASH=/usr/local/share/wcn/splash.png
if command -v feh >/dev/null 2>&1 && [ -r "$WCN_SPLASH" ]; then
    feh --no-fehbg --bg-center --image-bg black "$WCN_SPLASH" >/dev/null 2>&1 || xsetroot -solid black
else
    xsetroot -solid black 2>/dev/null || true
fi

# Support banner: an on-demand strip that shows a severity-coloured message support pushes from
# wc-field (the agent writes it to /var/lib/wcn/kiosk-message.txt). It appears ONLY while a message
# is active — when it does, it shrinks the RDP session below itself; when the message clears it
# hides and restores the session to full screen. All of that positioning lives in wcn-banner; this
# script just needs the screen size for the initial full-screen launch. Kept alive across reconnects.
read -r SCREEN_W SCREEN_H < <(xdotool getdisplaygeometry 2>/dev/null || echo "1920 1080")
case "${SCREEN_W:-}${SCREEN_H:-}" in *[!0-9]*|"") SCREEN_W=1920; SCREEN_H=1080 ;; esac
start_banner() {
    command -v python3 >/dev/null 2>&1 && [ -x /usr/local/bin/wcn-banner ] || return 0
    pgrep -f /usr/local/bin/wcn-banner >/dev/null 2>&1 || /usr/local/bin/wcn-banner >/dev/null 2>&1 &
}
start_banner

while true; do
    # Re-read on every pass, exactly like the target: a setting pushed from Watchman is then
    # picked up by the next reconnect even if the agent's kiosk restart never landed.
    read_settings
    apply_blanking "$BLANK"
    build_opts
    start_banner                    # keep the support banner alive across reconnects

    TARGET=$(pick_transport)
    while [ -z "$TARGET" ]; do sleep 3; TARGET=$(pick_transport); done
    RDP_USER_EFF=$(read_user)
    RDP_PASS_EFF=$(read_pass)
    # No credential is ever logged; OPTS holds only redirection and display switches.
    echo "$(date -Is) connecting via $TARGET [${OPTS[*]} blank:${BLANK}m]" >> /var/log/wcn-kiosk.log

    # Full screen and RESIZABLE (not /f, which is fixed): the WCN banner shrinks this window to sit
    # below itself while a support message is active, and restores it to full screen when the message
    # clears. /dynamic-resolution makes the remote session follow the local window size live, so the
    # resize is seamless rather than a reconnect.
    xfreerdp3 \
        /v:"$TARGET" \
        /u:"$RDP_USER_EFF" \
        /p:"$RDP_PASS_EFF" \
        /cert:ignore \
        /size:"${SCREEN_W}x${SCREEN_H}" \
        /dynamic-resolution \
        +auto-reconnect /auto-reconnect-max-retries:0 \
        /network:auto \
        "${OPTS[@]}" \
        -themes -wallpaper \
        /log-level:WARN 2>>/var/log/wcn-kiosk.log

    sleep 3
done
